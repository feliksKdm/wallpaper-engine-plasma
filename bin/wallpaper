#!/usr/bin/env bash
# wallpaper — switch animated Wallpaper Engine backgrounds on KDE Plasma (Wayland)
# using linux-wallpaperengine.
#
#   wallpaper                pick a wallpaper with live previews (needs fzf + chafa),
#                            otherwise the same as 'wallpaper list'
#   wallpaper list           list installed wallpapers
#   wallpaper <id>           switch to wallpaper <id> (remembered for next login)
#   wallpaper preview <id>   show the preview image of wallpaper <id> (needs chafa)
#   wallpaper current        show the current wallpaper
#   wallpaper stop           stop the animated wallpaper
#   wallpaper restore        start the remembered wallpaper (used by autostart)
#   wallpaper help           show this help

set -u

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wallpaper-engine-plasma"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_FILE="$CONFIG_DIR/current"

# Defaults, overridden by the config file written by install.sh
WPE_BIN=""
SCREENS=""
WORKSHOP_DIRS=""
EXTRA_ARGS=""
PREVIEW_FORMAT=""

# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

die() { echo "wallpaper: $*" >&2; exit 1; }

find_bin() {
    if [ -n "$WPE_BIN" ] && [ -x "$WPE_BIN" ]; then
        echo "$WPE_BIN"
    elif command -v linux-wallpaperengine >/dev/null 2>&1; then
        command -v linux-wallpaperengine
    else
        die "linux-wallpaperengine not found, set WPE_BIN in $CONFIG_FILE"
    fi
}

# Every Steam library that may hold Wallpaper Engine workshop items (app 431960)
find_workshop_dirs() {
    if [ -n "$WORKSHOP_DIRS" ]; then
        echo "$WORKSHOP_DIRS" | tr ':' '\n'
        return
    fi
    local roots=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/snap/steam/common/.local/share/Steam"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    )
    local root vdf
    {
        for root in "${roots[@]}"; do
            [ -d "$root/steamapps" ] || continue
            echo "$root"
            vdf="$root/steamapps/libraryfolders.vdf"
            [ -f "$vdf" ] && sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"/\1/p' "$vdf"
        done
    } | while read -r root; do
        [ -d "$root/steamapps/workshop/content/431960" ] && realpath "$root/steamapps/workshop/content/431960"
    done | sort -u
}

find_screens() {
    if [ -n "$SCREENS" ]; then
        echo "$SCREENS"
    elif command -v kscreen-doctor >/dev/null 2>&1; then
        kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
            | awk '/^Output:/ { name = $3 } /^[[:space:]]+enabled$/ { print name }' | tr '\n' ' '
    fi
}

wallpaper_dir() {
    local dir
    while read -r dir; do
        [ -d "$dir/$1" ] && { echo "$dir/$1"; return 0; }
    done < <(find_workshop_dirs)
    return 1
}

list_wallpapers() {
    local dirs=()
    mapfile -t dirs < <(find_workshop_dirs)
    [ ${#dirs[@]} -gt 0 ] || die "no Wallpaper Engine workshop folder found, set WORKSHOP_DIRS in $CONFIG_FILE"

    python3 -I - "${dirs[@]}" <<'PY'
import json, os, sys

for root in sys.argv[1:]:
    for item in sorted(os.listdir(root)):
        try:
            with open(os.path.join(root, item, "project.json"), encoding="utf-8") as f:
                project = json.load(f)
        except (OSError, ValueError):
            continue
        kind = str(project.get("type", "?")).lower()
        print("%-12s %-6s %s" % (item, kind, project.get("title", "?")))
PY
}

preview_file() {
    local dir
    dir="$(wallpaper_dir "$1")" || return 1
    python3 -I - "$dir" <<'PY'
import glob, json, os, sys

root = sys.argv[1]
try:
    with open(os.path.join(root, "project.json"), encoding="utf-8") as f:
        name = json.load(f).get("preview") or ""
except (OSError, ValueError):
    name = ""
candidates = [os.path.join(root, name)] if name else []
candidates += sorted(glob.glob(os.path.join(root, "preview.*")))
for path in candidates:
    if os.path.isfile(path):
        print(path)
        break
PY
}

# chafa can't detect the terminal from inside fzf's preview pane (stdout is not a tty there),
# so pick the graphics protocol up front from the environment
preview_format() {
    if [ -n "$PREVIEW_FORMAT" ]; then
        echo "$PREVIEW_FORMAT"
    elif [ -n "${KITTY_WINDOW_ID:-}" ] || [[ "${TERM:-}" == *kitty* ]] || [ -n "${GHOSTTY_RESOURCES_DIR:-}" ]; then
        echo kitty
    elif [ -n "${KONSOLE_VERSION:-}" ] || [ -n "${WEZTERM_EXECUTABLE:-}" ] || [[ "${TERM:-}" == foot* ]]; then
        echo sixels
    else
        echo symbols
    fi
}

show_preview() {
    local id="$1" size="${2:-}" file
    command -v chafa >/dev/null 2>&1 || die "chafa is not installed (sudo apt install chafa)"
    file="$(preview_file "$id")"
    [ -n "$file" ] || { echo "No preview for $id"; return 0; }
    # previews are often GIFs: show the first frame instead of animating forever
    chafa --animate off -f "${WALLPAPER_PREVIEW_FORMAT:-$(preview_format)}" ${size:+-s "$size"} "$file"
}

pick_wallpaper() {
    local current selected
    current="$(cat "$STATE_FILE" 2>/dev/null)"
    export WALLPAPER_PREVIEW_FORMAT
    WALLPAPER_PREVIEW_FORMAT="$(preview_format)"

    selected="$(list_wallpapers | fzf \
        --prompt 'wallpaper> ' \
        --header "Enter: set wallpaper   Esc: cancel   current: ${current:-none}" \
        --preview "'$0' preview {1} \"\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES}\"" \
        --preview-window 'right,55%,border-left')" || return 0

    set_wallpaper "${selected%% *}"
}

set_wallpaper() {
    wallpaper_dir "$1" >/dev/null || die "no wallpaper with id $1 (run 'wallpaper list' to list)"
    stop_wallpaper
    mkdir -p "$CONFIG_DIR"
    echo "$1" > "$STATE_FILE"
    start_wallpaper "$1"
    echo "Wallpaper set to $1"
}

stop_wallpaper() {
    # the kernel truncates process names to 15 characters
    pkill -x linux-wallpaper 2>/dev/null
    return 0
}

start_wallpaper() {
    local id="$1" bin screens args=() screen
    bin="$(find_bin)"
    screens="$(find_screens)"
    [ -n "$screens" ] || die "no screens found, set SCREENS in $CONFIG_FILE"

    for screen in $screens; do
        args+=(--screen-root "$screen")
    done
    # shellcheck disable=SC2206
    args+=(--bg "$id" $EXTRA_ARGS)

    # linux-wallpaperengine expects to run from its own folder (CEF resources live there)
    (cd "$(dirname "$bin")" && setsid nohup "$bin" "${args[@]}" >/dev/null 2>&1 &)
}

cmd="${1:-}"
case "$cmd" in
    "")
        if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1 && command -v chafa >/dev/null 2>&1; then
            pick_wallpaper
        else
            list_wallpapers
        fi
        ;;
    list|ls)
        list_wallpapers
        ;;
    preview)
        [ -n "${2:-}" ] || die "usage: wallpaper preview <id>"
        wallpaper_dir "$2" >/dev/null || die "no wallpaper with id $2 (run 'wallpaper list' to list)"
        show_preview "$2" "${3:-}"
        ;;
    current)
        [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "none"
        ;;
    stop)
        stop_wallpaper
        rm -f "$STATE_FILE"
        echo "Wallpaper stopped"
        ;;
    restore)
        [ -f "$STATE_FILE" ] || exit 0
        stop_wallpaper
        start_wallpaper "$(cat "$STATE_FILE")"
        ;;
    help|-h|--help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        [[ "$cmd" =~ ^[0-9]+$ ]] || die "unknown command '$cmd' (see 'wallpaper help')"
        set_wallpaper "$cmd"
        ;;
esac
